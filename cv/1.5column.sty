\NeedsTeXFormat{LaTeX2e}

% Page size
\usepackage[a4paper,vmargin={2cm,2cm},hmargin={5cm,2cm},marginparwidth=2.5cm,marginparsep=0.5cm]{geometry}
% Packages
\usepackage{xcolor}
\usepackage{setspace}
\usepackage{enumitem}
\usepackage{tabularx}
\usepackage{ragged2e}
\usepackage{lipsum}
\usepackage{fancyhdr}
\usepackage{hyperref}
\usepackage{fontawesome5}
% Font style
\usepackage{fontspec}
\setmainfont{SabonLTStd}[
    Path=./Fonts/Sabon/,
    Extension = .ttf,
    UprightFont=*-Regular,
    BoldFont=*-Bold,
    ItalicFont=*-Italic,
    BoldItalicFont=*-BoldItalic
    ]

\newfontfamily\Calluna{Calluna}[
    Path=./Fonts/Calluna/,
    Extension = .otf,
    UprightFont=*-Regular
    ]
\newfontfamily\Adobe{ACaslonPro}[
    Path=./Fonts/Adobe Caslon Pro/,
    UprightFont=*-Regular,
    BoldFont=*-Bold,
    ItalicFont=*-Italic,
    BoldItalicFont=*-BoldItalic
    ]
% Itemize Setting
\def\labelitemi{-} 
\setlist[itemize, 1]{itemsep=0pt, topsep=0pt, parsep=0pt, partopsep=0pt}

%%% Section Title %%%
\usepackage{titlesec}
\titleformat*{\section}{\fontfamily{lmss}\selectfont\normalsize\scshape\raggedright}
\titlespacing{\section}{0pt}{*0}{*0}

%%% Margin Note and Adjust Margin %%%
\usepackage{sidenotes}
\usepackage{changepage}
\newlength{\rulelength}
\setlength{\rulelength}{\dimexpr(\paperwidth-4cm)\relax}
\newcommand{\sectionBlock}[1]{\noindent\marginnote{\section*{#1}}}
\setlength\parindent{0pt}

% Page Numbering and Last Updated Statement
\pagestyle{fancy}
\fancyhf{} % Clear all header and footer fields
\lhead{}
\renewcommand{\headrulewidth}{0pt}%<---------------change
\fancyfoot[R]{\thepage} % Place the page number in the bottom-right
\fancyfoot[L]{\textcolor{lightgray}{\footnotesize Last updated: \today}} % Place last updated info in the bottom-left

% Hyoperlink Color
\definecolor{mycolor}{RGB}{158, 5, 7}
\hypersetup{
    colorlinks=true,           % Enable colored links
    linkcolor=mycolor,          % Color for internal links
    citecolor=mycolor,           % Color for citation links
    urlcolor=mycolor,           % Color for external links
    filecolor=mycolor,           % Color for file links
}